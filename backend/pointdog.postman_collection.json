          ]
        }
      ]
    },
    {
      "name": "Appointments",
      "description": "Endpoints de agendamento. Criação exclusiva para **CLIENTE**. Listagem, consulta e atualização de status para qualquer role autenticada.\n\n## Ciclo de status\n```\nPENDENTE → CONFIRMADO  (somente PRESTADOR)\nPENDENTE → CANCELADO   (CLIENTE ou PRESTADOR)\nCONFIRMADO → CANCELADO (CLIENTE ou PRESTADOR)\nCONFIRMADO → CONCLUIDO (somente PRESTADOR)\n```\nStatus `CANCELADO` e `CONCLUIDO` são terminais.",
      "item": [
        {
          "name": "POST /appointments",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/appointments", "host": ["{{baseUrl}}"], "path": ["appointments"] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduledAt\": \"2026-06-15T10:00:00.000Z\",\n  \"petId\": \"b2c3d4e5-...\",\n  \"providerId\": \"e5f6a7b8-...\",\n  \"serviceId\": \"c3d4e5f6-...\",\n  \"notes\": \"Por favor usar shampoo hipoalergênico\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Cria um novo agendamento. Exclusivo para **CLIENTE**.\n\n- `scheduledAt` deve ser uma data futura (ISO 8601)\n- `petId` deve pertencer ao cliente autenticado\n- `serviceId` deve existir\n- `notes` é opcional\n- Status inicial: `PENDENTE`"
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"d4e5f6a7-...\",\n  \"scheduledAt\": \"2026-06-15T10:00:00.000Z\",\n  \"status\": \"PENDENTE\",\n  \"notes\": \"Por favor usar shampoo hipoalergênico\",\n  \"clientId\": \"a1b2c3d4-...\",\n  \"petId\": \"b2c3d4e5-...\",\n  \"providerId\": \"e5f6a7b8-...\",\n  \"serviceId\": \"c3d4e5f6-...\"\n}"
            },
            {
              "name": "400 Data no passado",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Data deve ser futura\"\n}"
            },
            {
              "name": "403 Pet não pertence ao cliente",
              "status": "Forbidden",
              "code": 403,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Pet não pertence ao cliente\"\n}"
            },
            {
              "name": "404 Pet não encontrado",
              "status": "Not Found",
              "code": 404,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Pet não encontrado\"\n}"
            },
            {
              "name": "404 Serviço não encontrado",
              "status": "Not Found",
              "code": 404,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Serviço não encontrado\"\n}"
            }
          ]
        },
        {
          "name": "GET /appointments",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/appointments", "host": ["{{baseUrl}}"], "path": ["appointments"] },
