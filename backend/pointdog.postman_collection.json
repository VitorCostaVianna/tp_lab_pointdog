              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Acesso negado\"\n}"
            },
            {
              "name": "404 Serviço não encontrado",
              "status": "Not Found",
              "code": 404,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Serviço não encontrado\"\n}"
            }
          ]
        },
        {
          "name": "DELETE /services/:id",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/services/:id", "host": ["{{baseUrl}}"], "path": ["services", ":id"], "variable": [{ "key": "id", "value": "c3d4e5f6-..." }] },
            "header": [{ "key": "Authorization", "value": "Bearer {{prestadorToken}}" }],
            "description": "Remove um serviço. Apenas o prestador dono pode deletar. Retorna 204 sem body."
