{
  "info": {
    "name": "PointDog Sprint 2 — Demo",
    "_postman_id": "pointdog-sprint2-demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "tokenCliente", "value": "" },
    { "key": "tokenPrestador", "value": "" },
    { "key": "clientId", "value": "" },
    { "key": "providerId", "value": "" },
    { "key": "petId", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "appointmentId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Registrar Cliente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Maria Silva\",\n  \"email\": \"maria@demo.com\",\n  \"password\": \"123456\",\n  \"role\": \"CLIENTE\"\n}"
        }
      }
    },
    {
      "name": "2. Registrar Prestador",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Joao Groomer\",\n  \"email\": \"joao@demo.com\",\n  \"password\": \"123456\",\n  \"role\": \"PRESTADOR\"\n}"
        }
      }
    },
    {
      "name": "3. Login Cliente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var res = pm.response.json();",
              "pm.collectionVariables.set('tokenCliente', res.token);",
              "pm.collectionVariables.set('clientId', res.user.id);",
              "console.log('Token cliente salvo:', res.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"maria@demo.com\",\n  \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "4. Login Prestador",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var res = pm.response.json();",
              "pm.collectionVariables.set('tokenPrestador', res.token);",
              "pm.collectionVariables.set('providerId', res.user.id);",
              "console.log('Token prestador salvo:', res.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"joao@demo.com\",\n  \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "5. Criar Pet",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var res = pm.response.json();",
              "pm.collectionVariables.set('petId', res.id);",
              "console.log('Pet ID salvo:', res.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
        ],
        "url": { "raw": "{{baseUrl}}/pets", "host": ["{{baseUrl}}"], "path": ["pets"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rex\",\n  \"breed\": \"Labrador\",\n  \"size\": \"GRANDE\"\n}"
        }
      }
    },
    {
      "name": "6. Criar Serviço",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var res = pm.response.json();",
              "pm.collectionVariables.set('serviceId', res.id);",
              "console.log('Service ID salvo:', res.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenPrestador}}" }
        ],
        "url": { "raw": "{{baseUrl}}/services", "host": ["{{baseUrl}}"], "path": ["services"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Banho e Tosa\",\n  \"description\": \"Banho completo\",\n  \"price\": 80,\n  \"durationMinutes\": 90\n}"
        }
      }
    },
    {
      "name": "7. Criar Agendamento ← worker dispara aqui",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var res = pm.response.json();",
              "pm.collectionVariables.set('appointmentId', res.id);",
              "console.log('Appointment ID salvo:', res.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
        ],
        "url": { "raw": "{{baseUrl}}/appointments", "host": ["{{baseUrl}}"], "path": ["appointments"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scheduledAt\": \"2030-06-01T10:00:00.000Z\",\n  \"petId\": \"{{petId}}\",\n  \"providerId\": \"{{providerId}}\",\n  \"serviceId\": \"{{serviceId}}\",\n  \"notes\": \"Demo Sprint 2\"\n}"
        }
      }
    },
    {
      "name": "8. Confirmar Agendamento ← worker dispara aqui",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenPrestador}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/appointments/{{appointmentId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["appointments", "{{appointmentId}}", "status"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CONFIRMADO\"\n}"
        }
      }
    },
    {
      "name": "9. Concluir Agendamento ← worker dispara aqui",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenPrestador}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/appointments/{{appointmentId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["appointments", "{{appointmentId}}", "status"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CONCLUIDO\"\n}"
        }
      }
    }
  ]
}
